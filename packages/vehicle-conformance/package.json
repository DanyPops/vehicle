{
	"name": "@danypops/vehicle-conformance",
	"version": "0.4.1",
	"description": "Runner-neutral conformance suite for VehicleClient implementations, with Bun and Vitest adapters over one shared assertion matrix.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/bun.js",
	"types": "./dist/bun.d.ts",
	"exports": {
		".": {
			"types": "./dist/bun.d.ts",
			"default": "./dist/bun.js"
		},
		"./core": {
			"types": "./dist/vehicle-conformance.d.ts",
			"default": "./dist/vehicle-conformance.js"
		},
		"./vitest": {
			"types": "./dist/vitest.d.ts",
			"default": "./dist/vitest.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "bun run build && bun test test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@danypops/vehicle-core": "workspace:*",
		"@danypops/vehicle-server": "workspace:*"
	},
	"devDependencies": {
		"@danypops/vehicle-client": "workspace:*",
		"@types/node": "^22.0.0",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/vehicle.git",
		"directory": "packages/vehicle-conformance"
	},
	"keywords": ["vehicle", "agent-tools", "testing"],
	"files": ["src", "dist", "README.md"]
}
