{
	"name": "@danypops/vehicle-core",
	"version": "0.20.0",
	"description": "Vehicle's runtime-neutral wire contract: operation descriptors, schema codecs, failure shapes. Dependency-free root entry, optional TypeBox schema adapter, zero Bun-specific code -- the one thing every Vehicle client and server package depends on.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./typebox": {
			"types": "./dist/typebox/index.d.ts",
			"default": "./dist/typebox/index.js"
		},
		"./persistence": {
			"types": "./dist/persistence/index.d.ts",
			"default": "./dist/persistence/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "bun test test",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": { "typebox": "^1.3.6" },
	"peerDependenciesMeta": { "typebox": { "optional": true } },
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typebox": "^1.3.6",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/vehicle.git",
		"directory": "packages/vehicle-core"
	},
	"keywords": ["vehicle", "agent-tools"],
	"files": ["src", "dist", "README.md"]
}
